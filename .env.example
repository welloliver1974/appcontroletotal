# ==============================================================================
# LIFE OS HUB — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase / PostgreSQL
# ------------------------------------------------------------------------------
# Se NÃO definir, o app cai automaticamente pro mock localStorage (funciona offline).
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública / anônima (segura no navegador)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Chave de Serviço / Service Role (usada APENAS em serverless functions / api/ na Vercel)
# NUNCA prefixe com VITE_ para não vazar no bundle do navegador!
# SUPABASE_SERVICE_KEY="sua_chave_service_role_aqui"

# ------------------------------------------------------------------------------
# 2. Hermes Agent / VPS & Webhook
# ------------------------------------------------------------------------------
# URL da sua VPS ou Cloudflare Tunnel para o Hermes
VITE_HERMES_WEBHOOK_URL="https://hermes.seu-dominio.com/webhook"
VITE_HERMES_API_KEY="sua_chave_de_seguranca_hermes"

# Também suportado em ambiente Node/Serverless sem prefixo VITE_
# HERMES_WEBHOOK_URL="https://hermes.seu-dominio.com/webhook"
# HERMES_API_KEY="sua_chave_de_seguranca_hermes"

# ------------------------------------------------------------------------------
# 3. Provedores de IA / LLMs (Opcional - também configurável direto na UI do app)
# ------------------------------------------------------------------------------
# API Key da Groq (https://console.groq.com)
VITE_GROQ_API_KEY="gsk_..."

# API Key genérica compatível com OpenAI / OpenRouter / NVIDIA AI Foundation
VITE_LLM_API_KEY="sk-or-v1-..."

# ------------------------------------------------------------------------------
# 4. Telegram Bot (Briefing Matinal / Notificações)
# ------------------------------------------------------------------------------
# Token do Bot gerado pelo @BotFather
VITE_TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# ID do chat / seu usuário no Telegram (use @userinfobot para descobrir seu ID)
VITE_TELEGRAM_CHAT_ID="123456789"
